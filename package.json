{
    "name": "@hiddendevs/veil-ql-typeorm",
    "version": "1.0.3",
    "description": "Safely apply validated Veil-QL filters and sorting to TypeORM query builders.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HiddenDevs/veil-ql-typeorm.git"
    },
    "homepage": "https://github.com/HiddenDevs/veil-ql-typeorm#readme",
    "bugs": {
        "url": "https://github.com/HiddenDevs/veil-ql-typeorm/issues"
    },
    "keywords": [
        "query",
        "filter",
        "typeorm",
        "veil-ql"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && vitest run",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "peerDependencies": {
        "@hiddendevs/veil-ql": "^1.0.2",
        "typeorm": "^0.3.24"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@hiddendevs/veil-ql": "^1.0.2",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "sql.js": "^1.13.0",
        "typeorm": "^0.3.28",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
